# Copy to .env.local for local development. In production, set these in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Postgres connection string. Added for you when you connect a Neon database
# from the Vercel Marketplace. Leave it out locally to use a built-in dev database.
DATABASE_URL=

# Gmail account that sends every email (welcome, order confirmations, help desk).
# It is also the team inbox that receives help desk tickets, new orders and new accounts.
GMAIL_USER=marlowbybox@gmail.com

# A 16-character Google App Password for that account (not the normal password).
# Turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Optional: send team notices somewhere other than GMAIL_USER.
SUPPORT_EMAIL=

# Optional: the name shown next to the Gmail address. Defaults to Marlowby.
EMAIL_FROM_NAME=Marlowby

# Optional alternative to Gmail: Resend (https://resend.com). Only used when the Gmail
# variables are empty. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Public site address used in email links.
APP_URL=https://marlowbybox.vercel.app
